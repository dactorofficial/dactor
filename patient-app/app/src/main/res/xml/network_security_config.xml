<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Block cleartext HTTP across the entire application and enforce TLS -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Only trust verified system CAs; reject user-installed MITM proxy certificates -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
